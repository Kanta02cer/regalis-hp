{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionbank.example/schemas/marketing-report-v2.schema.json",
  "title": "Marketing Intelligence Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_run",
    "site",
    "data_quality",
    "executive_summary",
    "time_series",
    "keyword_portfolio",
    "competitors",
    "ai_visibility",
    "pages",
    "business_impact",
    "actions",
    "methodology"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "report_run": {"$ref": "#/$defs/reportRun"},
    "site": {"$ref": "#/$defs/site"},
    "data_quality": {"$ref": "#/$defs/dataQuality"},
    "executive_summary": {"$ref": "#/$defs/executiveSummary"},
    "time_series": {
      "type": "array",
      "items": {"$ref": "#/$defs/timeSeries"}
    },
    "keyword_portfolio": {
      "type": "array",
      "items": {"$ref": "#/$defs/keywordPortfolioItem"}
    },
    "competitors": {
      "type": "array",
      "items": {"$ref": "#/$defs/competitor"}
    },
    "ai_visibility": {"$ref": "#/$defs/aiVisibility"},
    "pages": {
      "type": "array",
      "items": {"$ref": "#/$defs/pageIntelligence"}
    },
    "business_impact": {"$ref": "#/$defs/businessImpact"},
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    },
    "alerts": {
      "type": "array",
      "items": {"$ref": "#/$defs/alert"},
      "default": []
    },
    "methodology": {"$ref": "#/$defs/methodology"},
    "legacy_v1": {
      "type": ["object", "null"],
      "description": "Optional compatibility payload."
    }
  },
  "$defs": {
    "reportRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "generated_at", "timezone", "code_version", "methodology_version", "status"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "generated_at": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string"},
        "code_version": {"type": "string"},
        "methodology_version": {"type": "string"},
        "status": {"enum": ["complete", "partial", "failed"]},
        "source_file_hash": {"type": ["string", "null"]},
        "tracking_cohort_id": {"type": ["string", "null"]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "canonical_url", "domain", "brand_name", "country_code", "language_code"],
      "properties": {
        "site_id": {"type": "string"},
        "canonical_url": {"type": "string", "format": "uri"},
        "domain": {"type": "string"},
        "brand_name": {"type": "string"},
        "industry": {"type": ["string", "null"]},
        "country_code": {"type": "string", "minLength": 2, "maxLength": 2},
        "language_code": {"type": "string"},
        "currency_code": {"type": "string", "minLength": 3, "maxLength": 3}
      }
    },
    "dataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_confidence", "source_freshness", "coverage", "limitations"],
      "properties": {
        "overall_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_freshness": {"type": "array", "items": {"$ref": "#/$defs/sourceFreshness"}},
        "coverage": {
          "type": "object",
          "additionalProperties": {"type": ["number", "integer", "null"]}
        },
        "limitations": {"type": "array", "items": {"type": "string"}},
        "denominator_changed": {"type": "boolean", "default": false}
      }
    },
    "sourceFreshness": {
      "type": "object",
      "required": ["source_type", "status"],
      "properties": {
        "source_type": {"type": "string"},
        "provider": {"type": ["string", "null"]},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "status": {"enum": ["fresh", "stale", "missing", "partial"]}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_key", "value", "unit", "measurement_type", "confidence", "methodology_version"],
      "properties": {
        "metric_key": {"type": "string"},
        "display_name": {"type": "string"},
        "value": {"type": ["number", "null"]},
        "value_low": {"type": ["number", "null"]},
        "value_high": {"type": ["number", "null"]},
        "unit": {"type": "string"},
        "measurement_type": {"enum": ["observed", "derived", "modeled", "inferred"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_type": {"type": "string"},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "methodology_version": {"type": "string"},
        "delta_7d": {"type": ["number", "null"]},
        "delta_28d": {"type": ["number", "null"]},
        "delta_90d": {"type": ["number", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "executiveSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "metrics", "wins", "risks", "next_actions"],
      "properties": {
        "headline": {"type": "string"},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "wins": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}},
        "next_actions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "timeSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_key", "unit", "points"],
      "properties": {
        "metric_key": {"type": "string"},
        "unit": {"type": "string"},
        "cohort_id": {"type": ["string", "null"]},
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp", "value"],
            "properties": {
              "timestamp": {"type": "string", "format": "date-time"},
              "value": {"type": ["number", "null"]},
              "confidence": {"type": ["number", "null"]},
              "annotation_ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "keywordPortfolioItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyword_id", "keyword", "category", "intent_stage", "metrics", "current_state", "opportunity", "evidence_ids"],
      "properties": {
        "keyword_id": {"type": "string"},
        "keyword": {"type": "string"},
        "category": {"type": "string"},
        "intent_stage": {"type": "string"},
        "job_to_be_done": {"type": ["string", "null"]},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "current_state": {
          "type": "object",
          "properties": {
            "best_position": {"type": ["integer", "null"]},
            "ranking_url": {"type": ["string", "null"]},
            "covered_by_us": {"type": ["boolean", "null"]},
            "competitor_count": {"type": ["integer", "null"]}
          }
        },
        "opportunity": {
          "type": "object",
          "required": ["priority_score", "recommended_action"],
          "properties": {
            "priority_score": {"type": "number"},
            "traffic_low": {"type": ["number", "null"]},
            "traffic_base": {"type": ["number", "null"]},
            "traffic_high": {"type": ["number", "null"]},
            "gross_profit_base": {"type": ["number", "null"]},
            "recommended_action": {"type": "string"}
          }
        },
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competitor_id", "canonical_name", "canonical_domain", "entity_type", "metrics", "new_wins", "losses"],
      "properties": {
        "competitor_id": {"type": "string"},
        "canonical_name": {"type": "string"},
        "canonical_domain": {"type": "string"},
        "entity_type": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "strengths": {"type": "array", "items": {"type": "string"}},
        "weaknesses": {"type": "array", "items": {"type": "string"}},
        "new_wins": {"type": "array", "items": {"type": "string"}},
        "losses": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "aiVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "engine_breakdown", "prompt_results"],
      "properties": {
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "engine_breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["engine", "metrics"],
            "properties": {
              "engine": {"type": "string"},
              "model": {"type": ["string", "null"]},
              "surface": {"type": ["string", "null"]},
              "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}}
            }
          }
        },
        "prompt_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["prompt_id", "prompt_text", "engine", "brand_state", "citations", "observed_at"],
            "properties": {
              "prompt_id": {"type": "string"},
              "prompt_text": {"type": "string"},
              "engine": {"type": "string"},
              "brand_state": {"enum": ["absent", "mentioned", "recommended", "compared", "criticized"]},
              "sentiment": {"type": ["number", "null"]},
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["url", "domain"],
                  "properties": {
                    "url": {"type": "string"},
                    "domain": {"type": "string"},
                    "is_own_domain": {"type": "boolean"},
                    "is_competitor": {"type": "boolean"}
                  }
                }
              },
              "observed_at": {"type": "string", "format": "date-time"},
              "evidence_id": {"type": "string"}
            }
          }
        }
      }
    },
    "pageIntelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "url", "page_type", "metrics", "issues", "opportunities"],
      "properties": {
        "page_id": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "page_type": {"type": "string"},
        "target_clusters": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "issues": {"type": "array", "items": {"type": "string"}},
        "opportunities": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "businessImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptions", "scenarios"],
      "properties": {
        "assumptions": {
          "type": "object",
          "additionalProperties": {"type": ["number", "string", "null"]}
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "traffic_opportunity", "revenue_opportunity", "gross_profit_opportunity", "confidence"],
            "properties": {
              "name": {"enum": ["low", "base", "high"]},
              "traffic_opportunity": {"type": ["number", "null"]},
              "revenue_opportunity": {"type": ["number", "null"]},
              "gross_profit_opportunity": {"type": ["number", "null"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "title", "action_type", "priority", "impact", "confidence", "effort", "status", "evidence_ids"],
      "properties": {
        "action_id": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "action_type": {"type": "string"},
        "target_url": {"type": ["string", "null"]},
        "target_keywords": {"type": "array", "items": {"type": "string"}},
        "priority": {"type": "number"},
        "impact": {"type": "number"},
        "confidence": {"type": "number"},
        "effort": {"type": "number"},
        "status": {"enum": ["proposed", "approved", "in_progress", "blocked", "done", "rejected"]},
        "owner": {"type": ["string", "null"]},
        "due_at": {"type": ["string", "null"], "format": "date-time"},
        "expected_impact": {"type": "object"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "alert": {
      "type": "object",
      "required": ["severity", "alert_type", "title", "detected_at"],
      "properties": {
        "severity": {"enum": ["info", "warning", "critical"]},
        "alert_type": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "detected_at": {"type": "string", "format": "date-time"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_definitions", "assumptions", "limitations"],
      "properties": {
        "metric_definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric_key", "formula", "unit", "measurement_type"],
            "properties": {
              "metric_key": {"type": "string"},
              "formula": {"type": "string"},
              "unit": {"type": "string"},
              "measurement_type": {"type": "string"}
            }
          }
        },
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "rank_weight_curve": {"type": ["object", "null"]},
        "source_registry": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
