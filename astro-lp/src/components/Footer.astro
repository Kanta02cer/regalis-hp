---
import { organization, navItems } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-accent-900 border-t border-white/10 py-12">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-4 md:flex-row md:items-start md:justify-between md:px-6"
  >
    <div class="flex flex-col items-center gap-3 md:items-start">
      <img
        src={organization.logo.horizontal.replace('.svg', '-light.svg')}
        alt={organization.name}
        width="180"
        height="43"
        class="h-9 w-auto"
      />
      <p class="text-xs text-white/50">運営会社：{organization.name}</p>
    </div>

    <nav
      aria-label="フッターナビゲーション"
      class="flex flex-wrap justify-center gap-x-6 gap-y-2 md:justify-end"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm text-white/70 transition-colors hover:text-main-300"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/author/"
        class="text-sm text-white/70 transition-colors hover:text-main-300"
      >
        監修者プロフィール
      </a>
    </nav>
  </div>
  <p class="mt-8 text-center text-xs text-white/40">
    © {year} {organization.name}
  </p>
</footer>
