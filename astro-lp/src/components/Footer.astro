---
import { site, navItems } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-accent-900 border-t border-white/10 py-10">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 md:flex-row md:justify-between md:px-6"
  >
    <p class="text-lg font-black text-white">{site.name}</p>
    <nav aria-label="フッターナビゲーション" class="flex flex-wrap justify-center gap-x-6 gap-y-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm text-white/70 transition-colors hover:text-main-300"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/author/"
        class="text-sm text-white/70 transition-colors hover:text-main-300"
      >
        監修者プロフィール
      </a>
    </nav>
    <p class="text-xs text-white/50">© {year} {site.name}</p>
  </div>
</footer>
