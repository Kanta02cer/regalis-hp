---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'ghost-light';
  size?: 'md' | 'lg';
  class?: string;
}

const { href, variant = 'primary', size = 'md', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-bold transition-transform duration-150 hover:scale-[1.03] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-main-600';
const variants = {
  primary: 'bg-main-500 text-white shadow-lg shadow-main-500/30 hover:bg-main-600',
  ghost:
    'border-2 border-accent-700 text-accent-700 bg-transparent hover:bg-accent-700 hover:text-white',
  'ghost-light':
    'border-2 border-white/70 text-white bg-white/5 backdrop-blur-sm hover:bg-white hover:text-accent-900',
};
const sizes = {
  md: 'px-6 py-3 text-sm',
  lg: 'px-10 py-4 text-base md:text-lg',
};
---

<a href={href} class:list={[base, variants[variant], sizes[size], className]}>
  <slot />
</a>
