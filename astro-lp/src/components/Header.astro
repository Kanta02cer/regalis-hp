---
import CtaButton from './CtaButton.astro';
import { site, navItems } from '../data/site';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-base-200 bg-base-50/90 backdrop-blur"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 md:px-6">
    <a href="#top" class="text-lg font-black tracking-tight text-accent-900">
      {site.name}
    </a>

    <nav aria-label="メインナビゲーション" class="hidden items-center gap-6 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-accent-900/80 transition-colors hover:text-main-600"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <CtaButton href={site.cta.primary.href} size="md">
      {site.cta.primary.label}
    </CtaButton>
  </div>
</header>
