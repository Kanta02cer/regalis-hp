---
import SectionHeading from './SectionHeading.astro';
import { curriculum } from '../data/site';
---

<section id="curriculum" class="bg-base-50 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <SectionHeading
      kicker="Curriculum"
      title="研修カリキュラム"
      lead="基礎から内製化まで、段階的にステップアップできる4つのプログラム。"
    />

    <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        curriculum.map((item) => (
          <li
            class="relative rounded-2xl border border-base-200 bg-white p-6 shadow-sm"
            data-animate="fade-up"
          >
            <span class="text-4xl font-black text-main-300" aria-hidden="true">
              {item.step}
            </span>
            <h3 class="mt-2 mb-1 text-lg font-bold text-accent-900">{item.title}</h3>
            <p class="mb-4 text-xs font-medium text-accent-900/60">
              {item.duration}｜{item.target}
            </p>
            <ul class="space-y-2">
              {item.points.map((point) => (
                <li class="flex items-start gap-2 text-sm text-accent-900/70">
                  <span class="mt-0.5 text-main-600" aria-hidden="true">
                    ✓
                  </span>
                  {point}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
