---
import SectionHeading from './SectionHeading.astro';
import { faqs } from '../data/site';

// FAQPage構造化データ（Googleリッチリザルト対応）
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<section id="faq" class="bg-base-50 py-20 md:py-28">
  <div class="mx-auto max-w-3xl px-4 md:px-6">
    <SectionHeading kicker="FAQ" title="よくあるご質問" />

    <div class="space-y-4">
      {
        faqs.map((faq) => (
          <details
            class="group rounded-2xl border border-base-200 bg-white shadow-sm"
            data-animate="fade-up"
          >
            <summary class="flex cursor-pointer items-center justify-between gap-4 p-6 font-bold text-accent-900 [&::-webkit-details-marker]:hidden">
              <span class="flex items-start gap-3">
                <span class="font-black text-main-600" aria-hidden="true">
                  Q.
                </span>
                {faq.question}
              </span>
              <span
                class="shrink-0 text-main-600 transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                ＋
              </span>
            </summary>
            <p class="px-6 pb-6 pl-13 text-sm leading-relaxed text-accent-900/70">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
