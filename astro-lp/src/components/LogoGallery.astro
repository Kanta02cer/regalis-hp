---
/**
 * ロゴ表示コンポーネント（ギャラリー）。
 *
 * デザインルール: ロゴは「正方形」または「横長の長方形」のタイルにのみ収める。
 *   - variant="square"     … 1:1 の正方形タイル
 *   - variant="horizontal" … 横長長方形タイル（既定）
 *
 * items が空の場合は「準備中」のプレースホルダータイルを表示する。
 * ※実企業のロゴを載せる場合は必ず掲載許諾を得ること。
 */
interface LogoItem {
  src: string;
  alt: string;
  href?: string;
}

interface Props {
  items?: LogoItem[];
  variant?: 'square' | 'horizontal';
  /** プレースホルダーで表示するタイル数（items未指定時） */
  placeholderCount?: number;
}

const { items = [], variant = 'horizontal', placeholderCount = 4 } = Astro.props;

// タイルのアスペクト比: 正方形 or 横長長方形（16:9相当）のみ許可
const tileAspect = variant === 'square' ? 'aspect-square' : 'aspect-[16/9]';
const gridCols =
  variant === 'square'
    ? 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4'
    : 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3';
---

<ul class:list={['grid gap-4', gridCols]}>
  {
    items.length > 0
      ? items.map((item) => (
          <li
            class:list={[
              tileAspect,
              'flex items-center justify-center rounded-xl border border-base-200 bg-white p-6 shadow-sm',
            ]}
          >
            {item.href ? (
              <a href={item.href} class="flex h-full w-full items-center justify-center">
                <img src={item.src} alt={item.alt} class="max-h-full max-w-full object-contain" loading="lazy" />
              </a>
            ) : (
              <img src={item.src} alt={item.alt} class="max-h-full max-w-full object-contain" loading="lazy" />
            )}
          </li>
        ))
      : Array.from({ length: placeholderCount }).map(() => (
          <li
            class:list={[
              tileAspect,
              'flex items-center justify-center rounded-xl border border-dashed border-base-300 bg-base-50 text-sm text-accent-900/40',
            ]}
          >
            準備中
          </li>
        ))
  }
</ul>
