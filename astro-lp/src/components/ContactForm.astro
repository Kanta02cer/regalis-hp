---
import SectionHeading from './SectionHeading.astro';

/**
 * 問い合わせフォーム（静的マークアップ）。
 * 送信先（Formspree / 自前API / Webhook等）確定後に form の action を設定する。
 * 必須は「会社名・メール・相談内容」の3項目に絞り、離脱率を下げる。
 */
const inquiryTypes = [
  '無料AI診断を受けたい',
  '資料請求',
  'AI研修のご相談',
  'AIシステム開発のご相談',
  'その他',
];
---

<section id="contact" class="bg-accent-900 py-20 md:py-28">
  <div class="mx-auto max-w-2xl px-4 md:px-6">
    <div class="mb-12 text-center" data-animate="fade-up">
      <p class="mb-2 text-sm font-bold tracking-widest text-main-300 uppercase">
        Contact
      </p>
      <h2 class="text-3xl font-black text-white md:text-4xl">
        お問い合わせ・無料相談
      </h2>
      <p class="mt-4 text-white/70">
        1分で入力完了。相談・資料請求ともに費用はかかりません。
      </p>
    </div>

    <form
      id="contact-form"
      class="space-y-6 rounded-2xl bg-base-50 p-8 shadow-xl md:p-10"
      method="post"
      action="#"
      data-animate="fade-up"
      novalidate
    >
      <div>
        <label for="company" class="mb-2 block text-sm font-bold text-accent-900">
          会社名 <span class="text-main-600">必須</span>
        </label>
        <input
          type="text"
          id="company"
          name="company"
          required
          autocomplete="organization"
          class="w-full rounded-lg border border-base-300 bg-white px-4 py-3 text-accent-900 focus:border-main-500 focus:outline-2 focus:outline-main-500/30"
          placeholder="株式会社サンプル"
        />
      </div>

      <div>
        <label for="email" class="mb-2 block text-sm font-bold text-accent-900">
          メールアドレス <span class="text-main-600">必須</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          class="w-full rounded-lg border border-base-300 bg-white px-4 py-3 text-accent-900 focus:border-main-500 focus:outline-2 focus:outline-main-500/30"
          placeholder="info@example.co.jp"
        />
      </div>

      <div>
        <label for="inquiry-type" class="mb-2 block text-sm font-bold text-accent-900">
          ご相談内容 <span class="text-main-600">必須</span>
        </label>
        <select
          id="inquiry-type"
          name="inquiry_type"
          required
          class="w-full rounded-lg border border-base-300 bg-white px-4 py-3 text-accent-900 focus:border-main-500 focus:outline-2 focus:outline-main-500/30"
        >
          <option value="">選択してください</option>
          {inquiryTypes.map((type) => <option value={type}>{type}</option>)}
        </select>
      </div>

      <div>
        <label for="message" class="mb-2 block text-sm font-bold text-accent-900">
          メッセージ <span class="text-accent-900/50 font-normal">任意</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="4"
          class="w-full rounded-lg border border-base-300 bg-white px-4 py-3 text-accent-900 focus:border-main-500 focus:outline-2 focus:outline-main-500/30"
          placeholder="現在の課題やご質問があればご記入ください"></textarea>
      </div>

      <!-- ハニーポット（ボット対策。人間には見えない） -->
      <div class="hp-field" aria-hidden="true">
        <label for="contact-website">Website</label>
        <input
          type="text"
          id="contact-website"
          name="website"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <button
        type="submit"
        class="w-full rounded-full bg-main-500 py-4 text-lg font-bold text-white shadow-lg shadow-main-500/30 transition-colors hover:bg-main-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-main-600"
      >
        送信する
      </button>
      <p id="contact-status" class="text-center text-sm text-main-700" role="status"></p>
      <p class="text-center text-xs text-accent-900/50">
        送信いただいた情報は、お問い合わせ対応の目的にのみ使用します。
      </p>
    </form>

    <!-- 送信完了メッセージ -->
    <div
      id="contact-success"
      class="rounded-2xl bg-base-50 p-10 text-center shadow-xl"
      hidden
    >
      <p class="text-3xl" aria-hidden="true">✅</p>
      <h3 class="mt-3 text-xl font-black text-accent-900">送信が完了しました</h3>
      <p class="mt-2 text-sm text-accent-900/70">
        お問い合わせありがとうございます。担当より1営業日以内にご連絡いたします。
      </p>
    </div>
  </div>
</section>

<style>
  /* ハニーポット: display:noneだと一部botが無視するため画面外に飛ばす */
  .hp-field {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  import { isRateLimited, recordSubmission, postLead, MIN_FILL_MS } from '../lib/leads';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  const success = document.getElementById('contact-success');
  const renderedAt = Date.now();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const honeypot = String(data.get('website') ?? '');

    function showSuccess() {
      form!.hidden = true;
      if (success) success.hidden = false;
    }

    // ボット判定: ハニーポット入力 or ページ表示から極端に速い送信 → 送信せず成功を装う
    if (honeypot !== '' || Date.now() - renderedAt < MIN_FILL_MS) {
      showSuccess();
      return;
    }
    if (!form.reportValidity()) return;
    if (isRateLimited()) {
      if (status)
        status.textContent = '送信間隔が短すぎます。しばらく待ってからお試しください。';
      return;
    }

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    if (status) status.textContent = '送信中…';

    try {
      await postLead({
        type: 'contact',
        email: String(data.get('email') ?? '').trim(),
        company: String(data.get('company') ?? '').trim(),
        inquiryType: String(data.get('inquiry_type') ?? ''),
        message: String(data.get('message') ?? '').trim(),
      });
      recordSubmission();
      showSuccess();
    } catch (error) {
      console.error(error);
      if (status)
        status.textContent = '送信に失敗しました。時間をおいて再度お試しください。';
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
