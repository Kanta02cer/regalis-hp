---
/**
 * サイト共通の構造化データ（JSON-LD）。
 * Organization / WebSite / Person を @graph で1タグに集約し、
 * @id 参照で相互に紐づける（E-E-A-T・表記ゆれ対策）。
 */
import { site, organization, author } from '../data/site';

const siteUrl = Astro.site?.href ?? 'https://example.com/';
const orgId = `${siteUrl}#organization`;
const personId = `${siteUrl}#author`;

// 未確定の項目（所在地・SNS等）は構造化データに出力しない
const orgNode: Record<string, unknown> = {
  '@type': 'Organization',
  '@id': orgId,
  name: organization.name,
  alternateName: [...organization.alternateNames],
  url: organization.url,
  logo: new URL(organization.logo.square, siteUrl).href,
  founder: { '@id': personId },
};
if (organization.sameAs.length > 0) orgNode.sameAs = [...organization.sameAs];
if (organization.addressLocality && organization.addressRegion) {
  orgNode.address = {
    '@type': 'PostalAddress',
    addressLocality: organization.addressLocality,
    addressRegion: organization.addressRegion,
    addressCountry: 'JP',
  };
}

const personNode: Record<string, unknown> = {
  '@type': 'Person',
  '@id': personId,
  name: author.name,
  alternateName: [...author.alternateNames],
  jobTitle: author.jobTitle,
  description: author.description,
  worksFor: { '@id': orgId },
  knowsAbout: [...author.knowsAbout],
  award: [...author.credentials],
  url: new URL('/author/', siteUrl).href,
};
if (author.sameAs.length > 0) personNode.sameAs = [...author.sameAs];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    orgNode,
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: site.name,
      alternateName: [...site.alternateNames],
      url: siteUrl,
      publisher: { '@id': orgId },
      inLanguage: 'ja',
    },
    personNode,
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
