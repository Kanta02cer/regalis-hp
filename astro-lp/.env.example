# リード送信先Webhook URL（Zapier Catch Hook / Make Custom Webhook等）
# ビルド時にクライアントJSへ埋め込まれる（PUBLIC_プレフィックス必須）
PUBLIC_LEAD_WEBHOOK_URL=

# ── ブログ自動下書き（scripts/auto_blog.js）用 ────────────────
# Claude APIで本文を生成する場合のみ設定（未設定時はテンプレートのスタブ生成）
ANTHROPIC_API_KEY=
# 生成に使うモデル（既定: claude-sonnet-5）
BLOG_MODEL=
# --push でPRを自動作成する場合に設定
GITHUB_TOKEN=
GITHUB_REPO=
