layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>{{ site.url }}/trillionbank/business/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>monthly</changefreq><priority>0.9</priority></url>
  <url><loc>{{ site.url }}/trillionbank/business/hack2/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>weekly</changefreq><priority>0.95</priority></url>
  <url><loc>{{ site.url }}/trillionbank/business/pay-per-crawl/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>monthly</changefreq><priority>0.8</priority></url>
  <url><loc>{{ site.url }}/trillionbank/company/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>monthly</changefreq><priority>0.85</priority></url>
  <url><loc>{{ site.url }}/trillionbank/insights/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>weekly</changefreq><priority>0.9</priority></url>
  <url><loc>{{ site.url }}/trillionbank/insights/editorial-policy/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>yearly</changefreq><priority>0.5</priority></url>
  <url><loc>{{ site.url }}/trillionbank/media/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>monthly</changefreq><priority>0.7</priority></url>
  <url><loc>{{ site.url }}/trillionbank/contact/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>monthly</changefreq><priority>0.8</priority></url>
  <url><loc>{{ site.url }}/trillionbank/meeting/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>monthly</changefreq><priority>0.85</priority></url>
  <url><loc>{{ site.url }}/trillionbank/privacy/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>yearly</changefreq><priority>0.4</priority></url>
  <url><loc>{{ site.url }}/trillionbank/terms/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>yearly</changefreq><priority>0.4</priority></url>
  <url><loc>{{ site.url }}/trillionbank/security/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>yearly</changefreq><priority>0.4</priority></url>
  <url><loc>{{ site.url }}/tokushoho.html</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>yearly</changefreq><priority>0.4</priority></url>

  <url><loc>{{ site.url }}/llms.txt</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>weekly</changefreq><priority>0.7</priority></url>
  <url><loc>{{ site.url }}/llms-full.txt</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>weekly</changefreq><priority>0.6</priority></url>
  <url><loc>{{ site.url }}/knowledge.json</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>monthly</changefreq><priority>0.5</priority></url>
  <url><loc>{{ site.url }}/site-structure.json</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod><changefreq>monthly</changefreq><priority>0.5</priority></url>

  {% assign approved_insights = site.tbnews | where: "insight", true | sort: "date" | reverse %}
  {% for item in approved_insights %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <lastmod>{% if item.last_modified %}{{ item.last_modified }}T00:00:00+09:00{% else %}{{ item.date | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.75</priority>
  </url>
  {% endfor %}
</urlset>
