---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
        http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

  <!-- ── Static pages (dynamic) ──────────────────────────── -->
  <!-- Excluded: /group/, /404, /lp/, /download/, /admin/, /hackii/, /results/ (listed explicitly below) -->
  {% for page in site.html_pages %}
    {% unless page.url contains '/404'
          or page.url contains '/group/'
          or page.url contains '/lp/'
          or page.url contains '/download/'
          or page.url contains '/admin/'
          or page.url == '/hackii/'
          or page.url contains '/hackii/hakaru'
          or page.url == '/results/' %}
    <url>
      <loc>{{ site.url }}{{ page.url | remove: "index.html" }}</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>{% if page.url == '/' %}weekly{% else %}monthly{% endif %}</changefreq>
      <priority>
        {%- if page.url == '/' -%}1.0
        {%- elsif page.url contains '/business/' -%}0.9
        {%- elsif page.url contains '/company/' or page.url contains '/about/' -%}0.85
        {%- elsif page.url contains '/contact/' -%}0.85
        {%- elsif page.url contains '/works/' -%}0.8
        {%- elsif page.url contains '/news/' -%}0.7
        {%- else -%}0.6
        {%- endif -%}
      </priority>
    </url>
    {% endunless %}
  {% endfor %}

  <!-- ── HackⅡ product pages (explicit) ───────────────────── -->
  <url>
    <loc>{{ site.url }}/hackii/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.95</priority>
  </url>
  <url>
    <loc>{{ site.url }}/hackii/hakaru/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.92</priority>
  </url>

  <!-- ── Results / Advisors page (explicit) ────────────────── -->
  <url>
    <loc>{{ site.url }}/results/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.88</priority>
  </url>

  <!-- ── News collection ──────────────────────────────────── -->
  {% assign sorted_news = site.news | sort: "date" | reverse %}
  {% for item in sorted_news %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    {% if item.last_modified %}<lastmod>{{ item.last_modified }}</lastmod>{% else %}<lastmod>{{ item.date | date_to_xmlschema }}</lastmod>{% endif %}
    <changefreq>{% if item.last_modified %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if item.last_modified %}0.90{% elsif item.date >= '2026-05-01' %}0.85{% else %}0.75{% endif %}</priority>
  </url>
  {% endfor %}

</urlset>
