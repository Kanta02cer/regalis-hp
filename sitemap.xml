<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
        http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- ルートページ（コーポレート）                                  -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- /business/* は /trillionbank/business/* へのリダイレクトスタブのため除外 -->

  <!-- ── HackⅡ（プロダクト） ───────────────────────────────── -->

  <!-- /company/, /about/philosophy.html, /about/company.html は /trillionbank/ 配下へのリダイレクトスタブのため除外 -->

  <!-- ── 実績・コンタクト・ニュース ──────────────────────────── -->
  <url>
    <loc>{{ site.url }}/results/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.85</priority>
  </url>
  <url>
    <loc>{{ site.url }}/works/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <!-- /contact/ は /trillionbank/contact/ へのリダイレクトスタブのため除外 -->
  <!-- /news/ は /trillionbank/media/ へのリダイレクトスタブのため除外（2026-08-13） -->
