  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- ニュース記事（自動生成）                                      -->
  <!-- ══════════════════════════════════════════════════════════ -->

  <!-- TB News（現在の正規記事） -->
  {% assign sorted_tbnews = site.tbnews | sort: "date" | reverse %}
  {% for item in sorted_tbnews %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <lastmod>{{ item.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}

