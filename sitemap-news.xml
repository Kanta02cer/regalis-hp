---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:news="http://www.google.com/schemas/sitemap-news/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
        http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

  {%- assign sorted_news = site.news | sort: "date" | reverse -%}
  {%- for item in sorted_news -%}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <news:news>
      <news:publication>
        <news:name>Regalis Japan Group Journal</news:name>
        <news:language>ja</news:language>
      </news:publication>
      <news:publication_date>{{ item.date | date_to_xmlschema }}</news:publication_date>
      <news:title>{{ item.title | xml_escape }}</news:title>
      {%- if item.keywords %}
      <news:keywords>{{ item.keywords | xml_escape }}</news:keywords>
      {%- endif %}
    </news:news>
    <lastmod>{{ item.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {%- endfor %}

</urlset>
